[Unit]
Description=PingoraHub Hub API
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=pingorahub
Group=pingorahub
EnvironmentFile=/etc/pingorahub/hub-api.env
ExecStart=/opt/pingorahub/bin/pingorahub-hub-api
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/pingorahub /var/lib/pingorahub /etc/pingorahub
WorkingDirectory=/opt/pingorahub

[Install]
WantedBy=multi-user.target
