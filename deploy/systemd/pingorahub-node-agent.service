[Unit]
Description=PingoraHub Node Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pingorahub
Group=pingorahub
EnvironmentFile=/etc/pingorahub/node-agent.env
ExecStart=/opt/pingorahub/bin/pingorahub-node-agent
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/pingorahub /var/lib/pingorahub /etc/pingorahub
WorkingDirectory=/opt/pingorahub

[Install]
WantedBy=multi-user.target
